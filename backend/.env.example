# Server-side keys — used by the engine to run scans on OUR account.
# Only set what you use; /api/health reports which are configured (booleans only).

# OpenAI — target model + analyzer (get from platform.openai.com)
OPENAI_API_KEY=your_key_here
# Optional: dedicated keys that take precedence over OPENAI_API_KEY
# PROMPTSHIELD_TARGET_OPENAI_KEY=your_key_here
# PROMPTSHIELD_ANALYZER_OPENAI_KEY=your_key_here

# Anthropic Claude (get from console.anthropic.com)
# ANTHROPIC_API_KEY=your_key_here

# Google Gemini (get from aistudio.google.com)
# GOOGLE_API_KEY=your_key_here

# Ollama (local LLM host)
# OLLAMA_HOST=http://localhost:11434

# Target model the web demo scans against (defaults to gpt-4o-mini)
# PROMPTSHIELD_TARGET_MODEL=gpt-4o-mini

# Frontend URL — for CORS lock (your Vercel URL once deployed)
# FRONTEND_URL=https://your-promptshield-frontend.vercel.app
