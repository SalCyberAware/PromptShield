# PromptShield environment variables template
# Copy this file to .env and fill in your real values
# NEVER commit .env to git — it's already in .gitignore

# ─── Provider API keys (only set the ones you'll test against) ───────────────

# Anthropic Claude API key
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ─── PromptShield analyzer keys (Phase 3 — multi-model ensemble) ─────────────

# Used by the Claude-based AI analyzer to evaluate target responses
PROMPTSHIELD_ANALYZER_ANTHROPIC_KEY=

# Used by the GPT-based validator analyzer
PROMPTSHIELD_ANALYZER_OPENAI_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# Default rate limit (requests per minute) per target
PROMPTSHIELD_RATE_LIMIT=10

# Default timeout per request (seconds)
PROMPTSHIELD_TIMEOUT=30
